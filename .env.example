# Copy this file to .env (never commit .env). Only MONGODB_URI is needed to run the app.

# MongoDB Atlas connection string. Ask a teammate for access to the shared cluster.
MONGODB_URI=
# Your own database, so your test data never collides with a teammate's: trove_dev_<yourname>
MONGODB_DATABASE=trove_dev_yourname

# Claude, for the AI features. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional; defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# Optional email delivery. Without SMTP_HOST, emails are printed in the API's terminal instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Trove <noreply@example.com>
# Any long random string; signs the links in emails.
EMAIL_LINK_SECRET=

FRONTEND_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:8000
