# Copy this file to .env (never commit .env). Only MONGODB_URI is needed to run the app.

# MongoDB Atlas connection string. Ask a teammate for access to the shared cluster.
MONGODB_URI=
# Your own database, so your test data never collides with a teammate's: trove_dev_<yourname>
MONGODB_DATABASE=trove_dev_yourname

# Claude, for the AI features. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional; defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# Optional email delivery. Without SMTP_HOST, emails are printed in the API's terminal instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Trove <noreply@example.com>
# Email through Brevo's web API (what the live site uses, since its host blocks SMTP). An API key, not an
# SMTP key. EMAIL_FROM must be a sender verified in Brevo. When set, the SMTP_* values above are not used.
BREVO_API_KEY=
# Any long random string; signs the links in emails.
EMAIL_LINK_SECRET=

# Sign-up needs a case.edu code or an invite. Set to false to sign up with any email while developing.
VERIFICATION_REQUIRED=true

# How many proxies sit in front of the API (a host's load balancer is 1). Leave 0 locally; see docs/deploy.md.
TRUSTED_PROXY_HOPS=0

FRONTEND_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:8000
