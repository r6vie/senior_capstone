# Copy this file to .env and paste your Atlas connection string after the equals sign.
# Replace the username/password placeholders locally. Do not share the real URI.
MONGODB_URI=
MONGODB_DATABASE=founderscircle

# AI interviewer. Get a key at console.anthropic.com; keep it only in .env.
ANTHROPIC_API_KEY=
# Optional: defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# Optional email delivery for account and connection notifications.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=founderscircleteam@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=FoundersCircle <founderscircleteam@gmail.com>
FRONTEND_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:8000
EMAIL_LINK_SECRET=paste-a-long-random-string-here

# LinkedIn sign-in (https://www.linkedin.com/developers/apps). Never share the secret.
# In the LinkedIn app, add the "Sign In with LinkedIn using OpenID Connect" product, and
# add this exact URL under Auth > Authorized redirect URLs for your app.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional; this is the local development default.
# LINKEDIN_REDIRECT_URI=http://127.0.0.1:5173/api/auth/linkedin/callback
