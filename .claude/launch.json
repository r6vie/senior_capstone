{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "api",
        "uvicorn",
        "trove.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "qc-api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "AI_MODE=scripted",
        "MONGODB_DATABASE=trove_dev_qc",
        "API_URL=http://127.0.0.1:8100",
        "FRONTEND_URL=http://127.0.0.1:5273",
        "uv",
        "run",
        "--directory",
        "api",
        "uvicorn",
        "trove.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8100"
      ],
      "port": 8100
    },
    {
      "name": "qc-web",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "TROVE_API_PORT=8100",
        "npm",
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5273",
        "--strictPort"
      ],
      "port": 5273
    }
  ]
}
