  "animation": {
    "size": "472x688, the cover at 2x, muted, no audio; MP4 (H.264) and WebM (VP9) of each",
    "loop": "the sign-in page only: paints in (all glazes by ~12.3 s), rests from 13.5 s, washes back to paper 18.5-23.5 s, 1.5 s clean paper; 25 s, 12 fps, seamless",
    "reveal": "the book reveal and your picks: the same painting at the same timing, played once, ending on the finished cover at 13.5 s; 12 fps",
    "quick": "the design studio, when you choose a design: the same painting at 0.3 of the time, ending on the finished cover at ~4 s; 24 fps",
    "poster": "the finished cover (the reveal's last frame); for reduced motion and before a video loads",
    "endsOnCover": "the last frame of reveal and quick is the cover image (mean difference under 0.1 levels of 255), so swapping to the still is invisible"
  }
