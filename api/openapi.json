  "components": {
    "schemas": {
      "AnswerRequest": {
        "properties": {
          "answer": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Answer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "answer"
        ],
        "title": "AnswerRequest"
      },
      "AuthorChapter": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "quotes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Quotes"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "quotes"
        ],
        "title": "AuthorChapter"
      },
      "BookCard": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "author_name": {
            "type": "string",
            "title": "Author Name"
          },
          "cover_style": {
            "type": "string",
            "enum": [
              "cover-1",
              "cover-2",
              "cover-3",
              "cover-4",
              "cover-5",
              "cover-6",
              "cover-7",
              "cover-8"
            ],
            "title": "Cover Style"
          },
          "blurb": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Blurb"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "author_name",
          "cover_style",
          "blurb"
        ],
        "title": "BookCard",
        "description": "A book as it appears on the shelf."
      },
      "Chapter": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "summary"
        ],
        "title": "Chapter"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InterviewResponse": {
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "interviewing",
              "choosing",
              "reviewing",
              "done"
            ],
            "title": "Stage"
          },
          "question": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Question"
              },
              {
                "type": "null"
              }
            ]
          },
          "topic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Topic"
          },
          "can_finish": {
            "type": "boolean",
            "title": "Can Finish"
          },
          "ready_for_reveal": {
            "type": "boolean",
            "title": "Ready For Reveal"
          },
          "titles": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/TitleOption"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Titles"
          }
        },
        "type": "object",
        "required": [
          "stage",
          "question",
          "topic",
          "can_finish",
          "ready_for_reveal",
          "titles"
        ],
        "title": "InterviewResponse"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "format": "password",
            "title": "Password",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "LoginResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type",
            "default": "bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "expires_in"
        ],
        "title": "LoginResponse"
      },
      "MyBookResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "author_name": {
            "type": "string",
            "title": "Author Name"
          },
          "cover_style": {
            "type": "string",
            "enum": [
              "cover-1",
              "cover-2",
              "cover-3",
              "cover-4",
              "cover-5",
              "cover-6",
              "cover-7",
              "cover-8"
            ],
            "title": "Cover Style"
          },
          "blurb": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Blurb"
          },
          "chapters": {
            "items": {
              "$ref": "#/components/schemas/AuthorChapter"
            },
            "type": "array",
            "title": "Chapters"
          },
          "copies": {
            "type": "integer",
            "title": "Copies"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "on_shelf"
            ],
            "title": "Status"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
